#!/bin/sh
# pre-commit 钩子（TASK-P1-02，审计 P18；TASK-P1-03 增补 ruff 步骤）
# 启用方式（每台开发机执行一次）:
#   git config core.hooksPath .githooks
# 检查内容: compileall 语法基线 + ruff 静态检查 + pytest -m smoke 冒烟
#            + mypy 增量类型检查（2026-09-05 批4：基线冻结只增不减）
# 绕过（自担风险）: git commit --no-verify

REPO_ROOT=$(git rev-parse --show-toplevel)
PY="$REPO_ROOT/runtime/py310/python.exe"
RUFF="$REPO_ROOT/tools/ruff/ruff.exe"

if [ ! -f "$PY" ]; then
  echo "[pre-commit] 未找到嵌入式 Python ($PY)，跳过检查"
  exit 0
fi

cd "$REPO_ROOT" || exit 1

echo "[pre-commit] [1/4] compileall 语法基线..."
# -x 排除 ComfyUI 便携目录（第三方 site-packages 含 py312 语法，py3.10 编译必炸）
"$PY" -m compileall -q backend launcher tools -x "ComfyUI_windows_portable|musubi-tuner"
if [ $? -ne 0 ]; then
  echo ""
  echo "[pre-commit] ✗ 语法错误，提交被拦截（修复后重试）"
  exit 1
fi

if [ -f "$RUFF" ]; then
  echo "[pre-commit] [2/4] ruff 静态检查..."
  "$RUFF" check .
  if [ $? -ne 0 ]; then
    echo ""
    echo "[pre-commit] ✗ ruff 检查未过，提交被拦截（修复后重试）"
    exit 1
  fi
else
  echo "[pre-commit] [2/4] 未找到 ruff.exe（$RUFF），跳过静态检查"
fi

echo "[pre-commit] [3/4] pytest -m smoke 冒烟测试..."
"$PY" -m pytest -m smoke -q
if [ $? -ne 0 ]; then
  echo ""
  echo "[pre-commit] ✗ 冒烟测试未过，提交被拦截（修复后重试；"
  echo "             或 git commit --no-verify 绕过，自担风险）"
  exit 1
fi

echo "[pre-commit] [4/4] mypy 增量类型检查（基线冻结只增不减）..."
"$PY" tools/run_mypy.py --staged
if [ $? -ne 0 ]; then
  echo ""
  echo "[pre-commit] ✗ mypy 新增类型错误，提交被拦截（修复；"
  echo "             或确认属基线漂移后 runtime/py310/python.exe tools/run_mypy.py --rebaseline 重审）"
  exit 1
fi

echo "[pre-commit] ✓ 全部通过"
exit 0
