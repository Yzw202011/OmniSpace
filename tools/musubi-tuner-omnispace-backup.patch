diff --git a/src/musubi_tuner/modules/custom_offloading_utils.py b/src/musubi_tuner/modules/custom_offloading_utils.py
index 5ae3091..6813062 100644
--- a/src/musubi_tuner/modules/custom_offloading_utils.py
+++ b/src/musubi_tuner/modules/custom_offloading_utils.py
@@ -838,9 +838,14 @@ class LoRAStreamOffloader:
 
     def _swap_modules(self, block: nn.Module) -> list[nn.Module]:
         # same selection rule as ModelOffloader.swap_weight_devices_cuda: Linear layers with a weight
+        # PATCH (OmniSpace 2026-09-15): exclude trainable modules (LoRA down/up) from streaming —
+        # they must stay resident on GPU, otherwise backward assigns CUDA grads to CPU params
+        # ("attempting to assign a gradient with device type 'cuda' to a tensor with device type 'cpu'").
         mods = []
         for _, m in block.named_modules():
-            if hasattr(m, "weight") and m.weight is not None and m.__class__.__name__.endswith("Linear"):
+            if (hasattr(m, "weight") and m.weight is not None
+                    and m.__class__.__name__.endswith("Linear")
+                    and not m.weight.requires_grad):
                 mods.append(m)
         return mods
 
